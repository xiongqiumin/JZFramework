{
  "name": "@jz/serialport",
  "version": "0.1.0",
  "description": "Node 'serialport' style wrapper over JZSerialPort for the JZ JS engine",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "jz:wrapper": {
    "source": "src/index.ts",
    "target": "dist/index.js",
    "loader": "JZJSEngine::runModuleFile"
  },
  "private": true
}
