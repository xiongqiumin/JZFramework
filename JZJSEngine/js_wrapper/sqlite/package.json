{
  "name": "@jz/sqlite",
  "version": "0.1.0",
  "description": "Node 'node:sqlite' style synchronous SQLite wrapper over JZDatabase for the JZ JS engine",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "jz:wrapper": {
    "source": "index.ts",
    "target": "dist/index.js",
    "loader": "JZJSEngine::runModuleFile"
  },
  "private": true
}
