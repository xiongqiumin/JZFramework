{
    "agentName":            "agent_cli",
    "version":              "1.0.0",
    "logFile":              "",

    "llm": {
        "url":              "",
        "name":             "",
        "token":            "",
        "netTimeoutMs":     120000,
        "maxRounds":        100,
        "maxToken":         100000,
        "maxRetries":       10,
        "maxFixRetries":    2,
        "retryDelayMs":     1000
    },

    "verify": {
        "maxRounds":        30,
        "timeoutMs":        60000
    },

    "memory": {
        "enabled":          true,
        "file":             "",
        "maxBytes":         8192
    },

    "terminal": {
        "rootDir":          "",
        "trustedDirs":      [],
        "shellProgram":     "",
        "programs":         {},
        "recycleSec":       900,
        "allowTerminal":    true,
        "allowFileTools":   true,
        "allowPackageManager": false,
        "allowNetwork":     false,
        "unrestricted":     false
    },

    "http": {
        "bind":             "127.0.0.1",
        "port":             8080,
        "token":            "",
        "dir":              ""
    }
}
