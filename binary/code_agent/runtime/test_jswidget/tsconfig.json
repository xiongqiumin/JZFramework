{
  // test_jswidget —— TS 版控件演示(code_runtime 的运行根 = 本目录/build)
  // 编译: <tsc> -p tsconfig.json
  // 运行: code_runtime --entry <本目录>/build/main.js
  "compilerOptions": {
    // 与 code_agent 的工程骨架(initProject 生成的 tsconfig)保持一致:
    // target ES2022 + lib ES2025 = quickjs 实际支持的范围; 不写 DOM, 否则
    // jz_types 里的全局 fetch/WebSocket/URL 会与 lib.dom.d.ts 撞成 duplicate identifier。
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2025"],
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "outDir": "build",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts",
    // 类型的单一来源: 仓库里的 js_wrapper 声明(引擎全局 + widget 全局类)。
    // 用户工程里不需要这些相对路径 —— initProject 会把部署的 jz_types 拷进工程,
    // include 写 "jz_types/**/*.d.ts" 即可。
    "../../../../JZJSEngine/js_wrapper/types/**/*.d.ts",
    "../../../../JZJSEngine/js_wrapper/widget/types/**/*.d.ts"
  ]
}
