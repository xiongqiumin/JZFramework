@PACKAGE_INIT@

# JZFramework installed package.
# The imported target carries the same compiler definitions and include paths
# that the in-tree JZFramework target exposes, so consumers do not need to
# repeat JZFRAMEWORK_DYNAMIC / JSON_DLL / HAS_JZ* / NOMINMAX manually.

set(_jz_root "${PACKAGE_PREFIX_DIR}")
set(_jz_inc_root "${_jz_root}/include/JZFramework")

# 安装时保留了模块目录结构；把所有目录加入搜索路径，消费方可以继续使用
# #include "JZApplication.h" / "JZJson.h" / "json/json.h" 这类裸文件名。
file(GLOB_RECURSE _jz_entries LIST_DIRECTORIES true "${_jz_inc_root}/*")
set(_jz_inc_dirs "${_jz_inc_root}")
foreach(_jz_e IN LISTS _jz_entries)
    if(IS_DIRECTORY "${_jz_e}")
        list(APPEND _jz_inc_dirs "${_jz_e}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _jz_inc_dirs)

if(@JZFRAMEWORK_DYNAMIC@)
    add_library(JZFramework::JZFramework SHARED IMPORTED)
    if(WIN32)
        # Debug 带 d 后缀，Release 不带；两种配置可同时装在同一前缀。
        set_target_properties(JZFramework::JZFramework PROPERTIES
            IMPORTED_CONFIGURATIONS "DEBUG;RELEASE"
            IMPORTED_LOCATION_DEBUG "${_jz_root}/bin/JZFrameworkd.dll"
            IMPORTED_IMPLIB_DEBUG "${_jz_root}/lib/JZFrameworkd.lib"
            IMPORTED_LOCATION_RELEASE "${_jz_root}/bin/JZFramework.dll"
            IMPORTED_IMPLIB_RELEASE "${_jz_root}/lib/JZFramework.lib"
            MAP_IMPORTED_CONFIG_DEBUG Debug
            MAP_IMPORTED_CONFIG_RELEASE Release
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
            MAP_IMPORTED_CONFIG_MINSIZEREL Release)
    elseif(APPLE)
        set_target_properties(JZFramework::JZFramework PROPERTIES
            IMPORTED_LOCATION "${_jz_root}/lib/libJZFramework.dylib")
    else()
        set_target_properties(JZFramework::JZFramework PROPERTIES
            IMPORTED_LOCATION "${_jz_root}/lib/libJZFramework.so")
    endif()
else()
    add_library(JZFramework::JZFramework STATIC IMPORTED)
    if(WIN32)
        set_target_properties(JZFramework::JZFramework PROPERTIES
            IMPORTED_CONFIGURATIONS "DEBUG;RELEASE"
            IMPORTED_LOCATION_DEBUG "${_jz_root}/lib/JZFrameworkd.lib"
            IMPORTED_LOCATION_RELEASE "${_jz_root}/lib/JZFramework.lib"
            MAP_IMPORTED_CONFIG_DEBUG Debug
            MAP_IMPORTED_CONFIG_RELEASE Release
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
            MAP_IMPORTED_CONFIG_MINSIZEREL Release)
    else()
        set_target_properties(JZFramework::JZFramework PROPERTIES
            IMPORTED_LOCATION "${_jz_root}/lib/libJZFramework.a")
    endif()
endif()

# ---- 共享模块: JZGame (2D 游戏层, 单独 DLL; 构建时启用才有) ----
# 用法: target_link_libraries(app PRIVATE JZFramework::JZGame JZFramework::JZFramework)
#   它自己 PUBLIC 链 JZFramework::JZFramework, 所以 include 路径/宏/JZGAME_DYNAMIC
#   会一起带出; 运行时把 bin/JZGame[d].dll 放到 exe 旁边即可。
set(_jz_has_game "@HAS_JZGame@")
if(_jz_has_game)
    add_library(JZFramework::JZGame SHARED IMPORTED)
    if(WIN32)
        set_target_properties(JZFramework::JZGame PROPERTIES
            IMPORTED_CONFIGURATIONS "DEBUG;RELEASE"
            IMPORTED_LOCATION_DEBUG "${_jz_root}/bin/JZGamed.dll"
            IMPORTED_IMPLIB_DEBUG "${_jz_root}/lib/JZGamed.lib"
            IMPORTED_LOCATION_RELEASE "${_jz_root}/bin/JZGame.dll"
            IMPORTED_IMPLIB_RELEASE "${_jz_root}/lib/JZGame.lib"
            MAP_IMPORTED_CONFIG_DEBUG Debug
            MAP_IMPORTED_CONFIG_RELEASE Release
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
            MAP_IMPORTED_CONFIG_MINSIZEREL Release)
    elseif(APPLE)
        set_target_properties(JZFramework::JZGame PROPERTIES
            IMPORTED_LOCATION "${_jz_root}/lib/libJZGame.dylib")
    else()
        set_target_properties(JZFramework::JZGame PROPERTIES
            IMPORTED_LOCATION "${_jz_root}/lib/libJZGame.so")
    endif()
    set_property(TARGET JZFramework::JZGame APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES ${_jz_inc_dirs})
    set_property(TARGET JZFramework::JZGame APPEND PROPERTY
        INTERFACE_COMPILE_DEFINITIONS JZGAME_DYNAMIC HAS_JZGame)
    set_property(TARGET JZFramework::JZGame APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES JZFramework::JZFramework)
endif()
unset(_jz_has_game)

set(_jz_defs "@JZ_INSTALL_MODULE_DEFS@")
if(@JZFRAMEWORK_DYNAMIC@)
    list(APPEND _jz_defs JZFRAMEWORK_DYNAMIC JSON_DLL)
    if("HAS_JZJSEngine" IN_LIST _jz_defs)
        list(APPEND _jz_defs USING_QJS_SHARED)
    endif()
endif()
list(APPEND _jz_defs NOMINMAX _CRT_SECURE_NO_WARNINGS)

set_property(TARGET JZFramework::JZFramework APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES ${_jz_inc_dirs})
set_property(TARGET JZFramework::JZFramework APPEND PROPERTY
    INTERFACE_COMPILE_DEFINITIONS ${_jz_defs})

if(WIN32)
    # JZWidget/JZNet/JZAudio 等模块用到的系统库。共享库消费方不强制需要，
    # 静态库消费方必须有；放在接口上对两种模式都安全。
    set_property(TARGET JZFramework::JZFramework APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES gdiplus imm32 shell32 comdlg32 ole32 user32 gdi32 iphlpapi winmm)
endif()

unset(_jz_root)
unset(_jz_inc_root)
unset(_jz_headers)
unset(_jz_inc_dirs)
unset(_jz_defs)

check_required_components(JZFramework)
